{
  "name": "@pactmandev/nonprofit-check-plus",
  "version": "1.0.6",
  "description": "Official Node.js SDK for the Pactman Nonprofit Check Plus API — verify US nonprofits by EIN against IRS BMF, Publication 78, Automatic Revocation and OFAC data.",
  "keywords": [
    "pactman",
    "nonprofit",
    "charity",
    "ein",
    "irs",
    "pub78",
    "bmf",
    "ofac",
    "compliance",
    "sdk"
  ],
  "homepage": "https://github.com/PledgeSoftwareTX/new-pactman-nonprofitcheck-api-sdks/tree/master/nodejs#readme",
  "bugs": {
    "url": "https://github.com/PledgeSoftwareTX/new-pactman-nonprofitcheck-api-sdks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PledgeSoftwareTX/new-pactman-nonprofitcheck-api-sdks.git",
    "directory": "nodejs"
  },
  "license": "MIT",
  "author": "Pactman",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:quickstart": "node examples/quickstart.mjs",
    "example:bulk": "node examples/bulk.mjs",
    "example:errors": "node examples/error-handling.mjs",
    "example:onboarding": "node examples/ex-26-onboarding-workflow.mjs",
    "examples:smoke": "node scripts/run-examples-against-mock.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "mock": "node scripts/mock-server.mjs",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
